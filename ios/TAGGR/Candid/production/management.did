type LogVisibility = variant { controllers; public; allowed_viewers : vec principal };
type SnapshotVisibility = variant { controllers; public; allowed_viewers : vec principal };
type EnvironmentVariable = record { name : text; value : text };
type CanisterSettings = record {
  controllers : opt vec principal;
  compute_allocation : opt nat;
  memory_allocation : opt nat;
  freezing_threshold : opt nat;
  reserved_cycles_limit : opt nat;
  log_visibility : opt LogVisibility;
  snapshot_visibility : opt SnapshotVisibility;
  wasm_memory_limit : opt nat;
  wasm_memory_threshold : opt nat;
  environment_variables : opt vec EnvironmentVariable;
};
type DefiniteCanisterSettings = record {
  controllers : vec principal;
  compute_allocation : nat;
  memory_allocation : nat;
  freezing_threshold : nat;
  reserved_cycles_limit : nat;
  log_visibility : LogVisibility;
  snapshot_visibility : SnapshotVisibility;
  wasm_memory_limit : nat;
  wasm_memory_threshold : nat;
  environment_variables : vec EnvironmentVariable;
};
type WasmMemoryPersistence = variant { keep; replace };
type InstallMode = variant {
  install;
  reinstall;
  upgrade : opt record {
    skip_pre_upgrade : opt bool;
    wasm_memory_persistence : opt WasmMemoryPersistence;
  };
};
type InstallCodeArgs = record {
  arg : blob;
  canister_id : principal;
  mode : InstallMode;
  sender_canister_version : opt nat64;
  wasm_module : blob;
};
type CanisterStatusArgs = record { canister_id : principal };
type MemoryMetrics = record {
  wasm_memory_size : nat;
  stable_memory_size : nat;
  global_memory_size : nat;
  wasm_binary_size : nat;
  custom_sections_size : nat;
  canister_history_size : nat;
  wasm_chunk_store_size : nat;
  snapshots_size : nat;
};
type QueryStats = record {
  num_calls_total : nat;
  num_instructions_total : nat;
  request_payload_bytes_total : nat;
  response_payload_bytes_total : nat;
};
type CanisterStatus = record {
  status : variant { running; stopping; stopped };
  ready_for_migration : bool;
  version : nat64;
  settings : DefiniteCanisterSettings;
  module_hash : opt blob;
  memory_size : nat;
  memory_metrics : MemoryMetrics;
  cycles : nat;
  reserved_cycles : nat;
  idle_cycles_burned_per_day : nat;
  query_stats : QueryStats;
};
type UpdateSettingsArgs = record {
  canister_id : principal;
  sender_canister_version : opt nat64;
  settings : CanisterSettings;
};
service : {
  install_code : (InstallCodeArgs) -> ();
  canister_status : (CanisterStatusArgs) -> (CanisterStatus) query;
  update_settings : (UpdateSettingsArgs) -> ();
};
