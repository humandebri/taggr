type HttpRequest = record { url : text; headers : vec record { text; text } };
type HttpResponse = record {
  status_code : nat16;
  headers : vec record { text; text };
  body : blob;
  upgrade : opt bool;
};
service : {
  add_session : (principal) -> ();
  free : (vec record { nat64; nat64 }) -> ();
  http_request : (HttpRequest) -> (HttpResponse) query;
  stats : () -> (nat64, nat64) query;
  update_internal_controllers : (vec principal) -> ();
};
