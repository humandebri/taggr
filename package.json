{
    "name": "taggr",
    "version": "0.1.0",
    "description": "Decentralized Social Network",
    "keywords": [
        "TypeScript",
        "Canister"
    ],
    "scripts": {
        "build": "webpack",
        "postbuild": "find dist/frontend -name '*.js' -exec gzip -9n {} +",
        "start": "webpack serve --mode development --env development",
        "tauri": "tauri",
        "ios:dev": "tauri ios dev",
        "ios:open": "tauri ios dev --open",
        "ios:build": "tauri ios build",
        "ios:audit": "node scripts/ios/tauri-audit.js",
        "ios:aasa:local": "node scripts/ios/local-aasa-check.js",
        "ios:frontend:local": "node scripts/ios/local-frontend-check.js",
        "ios:lines": "node scripts/ios/line-count-check.js",
        "ios:dfx": "node scripts/ios/dfx-version-check.js",
        "ios:identity": "node scripts/ios/prod-identity-check.js",
        "ios:blockers": "node scripts/ios/blockers.js",
        "ios:deploy:ready": "node scripts/ios/deploy-readiness.js",
        "ios:aasa": "node scripts/ios/aasa-check.js",
        "ios:preflight": "node scripts/ios/tauri-preflight.js",
        "ios:review": "node scripts/ios/review-preflight.js",
        "ios:completion": "node scripts/ios/completion-audit.js",
        "test:e2e": "playwright test",
        "install:e2e": "playwright install chromium --with-deps",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "devDependencies": {
        "@playwright/test": "1.56.1",
        "@tauri-apps/api": "2.11.0",
        "@tauri-apps/cli": "2.11.1",
        "@tauri-apps/plugin-deep-link": "2.4.9",
        "@tauri-apps/plugin-opener": "2.5.4",
        "@types/isomorphic-fetch": "0.0.39",
        "@types/react-dom": "19.0.0",
        "buffer": "6.0.3",
        "copy-webpack-plugin": "^14.0.0",
        "html-webpack-plugin": "5.5.3",
        "isomorphic-fetch": "3.0.0",
        "prettier": "^3.3.3",
        "process": "0.11.10",
        "raw-loader": "4.0.2",
        "react": "19.0.0",
        "react-dom": "19.0.0",
        "terser-webpack-plugin": "^5.3.10",
        "ts-loader": "9.5.0",
        "typescript": "5.8.3",
        "webpack": "^5.106.2",
        "webpack-cli": "5.1.4",
        "webpack-dev-server": "^5.1.0"
    },
    "browserslist": [
        "last 2 chrome version",
        "last 2 firefox version",
        "last 2 safari version",
        "last 2 edge version"
    ],
    "dependencies": {
        "@dfinity/agent": "2.4.1",
        "@dfinity/auth-client": "2.4.1",
        "@dfinity/candid": "2.4.1",
        "@dfinity/identity": "2.4.1",
        "@dfinity/ledger-icrc": "2.8.0",
        "@dfinity/principal": "2.4.1",
        "@preact/signals": "2.9.0",
        "@radix-ui/react-avatar": "1.1.11",
        "@radix-ui/react-dialog": "1.1.15",
        "@radix-ui/react-dropdown-menu": "2.1.16",
        "@radix-ui/react-scroll-area": "1.2.10",
        "@radix-ui/react-slot": "1.2.4",
        "@radix-ui/react-tabs": "1.1.13",
        "@tailwindcss/postcss": "4.3.0",
        "class-variance-authority": "0.7.1",
        "clsx": "2.1.1",
        "css-loader": "7.1.4",
        "diff-match-patch": "1.0.5",
        "lucide-react": "1.14.0",
        "postcss": "8.5.14",
        "postcss-loader": "8.2.1",
        "preact": "10.29.1",
        "style-loader": "4.0.0",
        "tailwind-merge": "3.6.0",
        "tailwindcss": "4.3.0"
    }
}
